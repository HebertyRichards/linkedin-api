# Copy to .env for local runs only (git-ignored). In production set these in Railway -> Variables.
# How to get each value: README.md, "Environment variables".

# --- What to watch (required) ---
# Up to 3 searches, comma separated. Each one is a LinkedIn job search with the Easy Apply filter.
# Try each term in LinkedIn's search first: an unknown term is dropped and you get jobs from any field.
JOB_KEYWORDS=python, typescript
# English name, as LinkedIn spells it: "Brazil", "São Paulo". "Brasil" is not recognized.
JOB_LOCATION=Brazil

# --- Email channel (all or none) ---
RESEND_API_KEY=
# Without a verified domain, Resend only delivers to the email of your Resend account.
EMAIL_TO=
# EMAIL_FROM=alerts@your-domain.com

# --- WhatsApp channel (all or none) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Country + area code + number (5511999999999) or a group id (...@g.us).
WHATSAPP_TO=

# --- Job assessment by AI (optional: both or none) ---
# Free key at console.groq.com -> API Keys. Each new job gets a 0-100 score against your resume.
LLM_API_KEY=
# Your resume in YAML (git-ignored; contact data is never sent to the AI). Example: curriculo_base.yaml
RESUME_FILE=
# On Railway the file does not exist: paste the whole YAML into RESUME_YAML instead (one or the other).
# RESUME_YAML=
# Any OpenAI-compatible API works (OpenRouter, Mistral, Ollama on http://localhost:11434/v1).
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# Model that tailors the resume (PDF attached to the email) for jobs scored 50 or more.
# LLM_TAILOR_MODEL=openai/gpt-oss-120b

# --- Optional ---
# NOTIFY_PRIMARY=whatsapp
# POLL_INTERVAL_SECONDS=1800
# STATE_FILE=/data/seen.json
# LOG_LEVEL=INFO
# APP_ENV=production
# LOG_JSON=true
