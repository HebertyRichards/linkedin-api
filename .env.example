# Copy to .env for local runs only (git-ignored). In production set these in Railway -> Variables.
# How to get each value: README.md, "Environment variables".

# --- What to watch (required) ---
# Up to 3 searches, comma separated, in LinkedIn's syntax: ("full stack developer" OR fullstack) NOT senior.
# Every job of the search is listed, Easy Apply or not. Try each term in LinkedIn's search first: an unknown
# term is dropped and you get jobs from any field.
# Gupy, Remotar, Himalayas and Workable read the same value: each OR alternative becomes its own request (they
# do not understand OR, NOT or quotes), so 3 searches of 4 alternatives each are 12 requests per source per read.
# LinkedIn does not always honor NOT: on every source the worker drops a job whose title has a word starting
# with a NOT term, accents ignored ("NOT consultor" drops "Consultores"). Add NOT sr NOT líder NOT lead to
# also drop titles such as "Desenvolvedor Sr. Full Stack" and "Líder Técnico".
JOB_KEYWORDS=python, typescript
# English name, as LinkedIn spells it: "Brazil", "São Paulo". "Brasil" is not recognized. Gupy keeps the jobs
# whose city, state or country it names; Remotar, Himalayas and Workable ignore it (Brazil only).
JOB_LOCATION=Brazil

# --- Email channel (all or none) ---
RESEND_API_KEY=
# Without a verified domain, Resend only delivers to the email of your Resend account.
EMAIL_TO=
# EMAIL_FROM=alerts@your-domain.com

# --- WhatsApp channel (all or none) ---
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Country + area code + number (5511999999999) or a group id (...@g.us).
WHATSAPP_TO=

# --- Telegram channel (all or none) ---
# @BotFather -> /newbot. Send /start to your bot, then read message.chat.id at
# https://api.telegram.org/bot<token>/getUpdates (numbers only).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Job score by AI (required) ---
# Free key at console.groq.com -> API Keys. Each new job gets a 0-100 score against your resume;
# only a job scored 50 or more is sent.
LLM_API_KEY=
# Your resume in YAML (git-ignored; contact data is never sent to the AI). Start from curriculo.example.yaml.
RESUME_FILE=
# On Railway the file does not exist: paste the whole YAML into RESUME_YAML instead (one or the other).
# RESUME_YAML=
# Any OpenAI-compatible API works (OpenRouter, Mistral, Ollama on http://localhost:11434/v1).
# LLM_API_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# Model that tailors the resume (PDF attached) for every job sent.
# LLM_TAILOR_MODEL=openai/gpt-oss-120b
# Optional fallback provider (all three or none), asked when Groq is down or its free quota is used up.
# It must accept response_format json_schema (structured outputs). It also gets the resume, without contact data.
# LLM_FALLBACK_API_URL=https://openrouter.ai/api/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=openai/gpt-oss-20b:free

# --- Optional ---
# email, whatsapp or telegram
# NOTIFY_PRIMARY=whatsapp
# POLL_INTERVAL_SECONDS=1800
# STATE_FILE=/data/seen.json
# LOG_LEVEL=INFO
# APP_ENV=production
# LOG_JSON=true
