{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.development)",
      "Read(//**/.env.production)",
      "Read(//**/.env.test)",
      "Edit(//**/.env)",
      "Edit(//**/.env.local)",
      "Edit(//**/.env.production)",
      "Write(//**/.env)",
      "Write(//**/.env.local)",
      "Write(//**/.env.production)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v python || command -v python3)\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\" || exit 2"
          }
        ]
      }
    ]
  }
}
